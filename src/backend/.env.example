# ==============================================================================
# CONFIGURACIÓN DE AMBIENTE DE EJEMPLO - BACKEND (.NET 8)
# ==============================================================================
# Copie este archivo como '.env' o configure estas variables en su entorno/secrets.
# NOTA: No coloque secretos reales en control de versiones.

# Entorno de ejecución de ASP.NET Core (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Cadena de conexión SQL Server
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=SB_GestionSolicitudes;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# Configuración JWT (Clave secreta mínima de 256 bits / 32 caracteres)
JWT_SECRET=REPLACE_WITH_YOUR_STRONG_SECRET_KEY_MIN_32_CHARACTERS_LONG_123456
JwtSettings__Issuer=SB.GestionSolicitudes.Api
JwtSettings__Audience=SB.GestionSolicitudes.Clients
JwtSettings__ExpirationInMinutes=60

# Puerto de escucha del backend
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001
